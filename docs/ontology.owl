        <isIvd rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIvd>
        <isReusable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isReusable>
        <riskClass>ClassC</riskClass>
        <udiDi>(01)04015630001016</udiDi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#fsca001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#fsca001">
        <rdf:type rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <respondsToIncident rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#inc001"/>
        <actionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-01</actionDate>
