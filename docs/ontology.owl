<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#"
     xml:base="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:terms1="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#terms:"
     xmlns:meddevices="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices/1.0.0"/>
        <dc:description xml:lang="en">dc:description

This is an ontology on the European catalog of medical devices of high risk and in vitro diagnostic devices. Based on the MDR Regulation (EU 2017/745) and the IVDR Regulation (EU 2017/746)</dc:description>
        <dc:title xml:lang="en">An ontology about medical devices and their risks</dc:title>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-26</terms:created>
        <terms:creator>Miquel Alba Castelló</terms:creator>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <rdfs:label>meddevice</rdfs:label>
        <rdfs:seeAlso xml:lang="en">http://data.europa.eu/eli/reg/2017/745/oj</rdfs:seeAlso>
        <rdfs:seeAlso xml:lang="en">http://data.europa.eu/eli/reg/2017/746/oj</rdfs:seeAlso>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#terms:creator -->


    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#terms:creator"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#license -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#license"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#sameAs -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#sameAs"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#affectsDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#affectsDeviceType">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isAffectedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">This property show us which device is affected by the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">affectsDeviceType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasDevice">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isDeviceOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">This property links the device  and the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">hasDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasRegulatoryFramework -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasRegulatoryFramework">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#regulatesDevice"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#RegulatoryFramework"/>
        <rdfs:comment xml:lang="en">This property links the device  with the regulatory framework.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRegulatoryFramework</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasRisk -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasRisk">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isRiskOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">This property links an Incident to the Risk identified.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRisk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isAffectedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isAffectedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">This property shows the risk that affect at device</rdfs:comment>
        <rdfs:label xml:lang="en">isAffectedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isDeviceOf -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isDeviceOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:comment xml:lang="en">This property links the incident and the device .</rdfs:comment>
        <rdfs:label xml:lang="en">isDeviceOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isManufacturedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isManufacturedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#manufacturesDevice"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:comment xml:lang="en">A property created to recognize the manufacturer for each device.</rdfs:comment>
        <rdfs:label xml:lang="en">isManufacturedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isRespondedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isRespondedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#respondsToIncident"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">This property shows which the relation betwees the incident and the corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">isRespondedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isRiskOf -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isRiskOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:comment xml:lang="en">This property links the Risk that affect an Incident</rdfs:comment>
        <rdfs:label xml:lang="en">isRiskOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#manufacturesDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#manufacturesDevice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">A property created to recognize the manufacturer of the device.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturesDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#regulatesDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#regulatesDevice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#RegulatoryFramework"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
        <rdfs:comment xml:lang="en">This property links the  the regulatory framework with the device.</rdfs:comment>
        <rdfs:label xml:lang="en">regulatesDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#reportedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#reports"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:comment xml:lang="en">This property shows which manufacturer reported the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">reportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#reports -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#reports">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:comment xml:lang="en">This property shows which the incident of each manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">reports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#respondsToIncident -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#respondsToIncident">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:comment xml:lang="en">This property shows which the relation betwees the corrective action and the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">respondsToIncident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#actionDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#actionDate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">This data property shows when the action was taken.</rdfs:comment>
        <rdfs:label xml:lang="en">actionDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#actionDescription -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#actionDescription">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This data property shows when the action description.</rdfs:comment>
        <rdfs:label xml:lang="en">actionDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#authorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#authorizationNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Data property thats shows the manufacturer authorization umber to operate.</rdfs:comment>
        <rdfs:label xml:lang="en">authorizationNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#closureDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#closureDate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">This data property shows when the action was closed.</rdfs:comment>
        <rdfs:label xml:lang="en">closureDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#competentAuthority -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#competentAuthority">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Data property thats shows the competent authority that supervise the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">competentAuthority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#contactEmail -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#contactEmail">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Data property thats shows the manufacturer email address.</rdfs:comment>
        <rdfs:label xml:lang="en">contactEmail</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#correctiveActionTaken -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#correctiveActionTaken">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">This property shows the corrective acction because of the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">correctiveActionTaken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#countriesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#countriesAffected">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This data property shows when the countries where the action was taken.</rdfs:comment>
        <rdfs:label xml:lang="en">countriesAffected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#country -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#country">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Data property thats shows the manufacturer country.</rdfs:comment>
        <rdfs:label xml:lang="en">country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#countryReported -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#countryReported">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This property shows in wich country the incident was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">countryReported</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#description -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#description">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Data property that shows the risk description.</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#detectionDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#detectionDate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">This data property shows when the incident was detected.</rdfs:comment>
        <rdfs:label xml:lang="en">detectionDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#deviceId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#deviceId">
