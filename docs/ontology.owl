    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#inc001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#inc001">
        <rdf:type rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SeriousIncident"/>
        <hasDevice rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#dev001"/>
        <hasRisk rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#rsk003"/>
        <reportedBy rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#man001"/>
        <correctiveActionTaken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</correctiveActionTaken>
        <countryReported>Germany</countryReported>
        <detectionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-10</detectionDate>
        <eudamedIncidentRef>EU-INC-2024-000001</eudamedIncidentRef>
        <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-08</eventDate>
        <incidentDescription>Patient implanted with HeartMate 3 LVAD developed ischemic stroke 6 months post-implant. Device thrombus confirmed by echocardiography.</incidentDescription>
        <outcome>Serious patient injury - embolic stroke</outcome>
