        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
        <rdfs:sameAs rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://publications.europa.eu/resource/authority/role/AUTHORI</rdfs:sameAs>
        <skos:prefLabel xml:lang="en">Authorising Entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MaterialRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MaterialRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that represents a material risk.</rdfs:comment>
        <rdfs:label xml:lang="en">MaterialRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice">
        <rdfs:comment xml:lang="en">The pattern that describes the set of classes of the Ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">MedicalDevice</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://publications.europa.eu/resource/authority/class-sum-leg/2403020204</rdfs:seeAlso>
        <skos:prefLabel xml:lang="en">Medical Device</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#NearMissIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#NearMissIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SeriousIncident"/>
        <rdfs:comment xml:lang="en">Incident almost gone.</rdfs:comment>
        <rdfs:label xml:lang="en">NearMissIncident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#RadiationRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#RadiationRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that represents a radiation risk.</rdfs:comment>
        <rdfs:label xml:lang="en">RadiationRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Recall -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Recall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Any corrective action that needs a recall.</rdfs:comment>
        <rdfs:label xml:lang="en">Recall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#RegulatoryFramework -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#RegulatoryFramework">
        <rdfs:comment xml:lang="en">The regulatory framework for device.</rdfs:comment>
        <rdfs:label xml:lang="en">RegulatoryFramework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#affectsDeviceType"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class that contains a catalog of risks identified according to the IMDRF nomenclature.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
        <rdfs:sameAs rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Risk</rdfs:sameAs>
        <skos:prefLabel xml:lang="en">Risk</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SafetyAlert -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SafetyAlert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Any corrective action that involves a health alert.</rdfs:comment>
        <rdfs:label xml:lang="en">SafetyAlert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SelfTestDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SelfTestDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">A self test device.</rdfs:comment>
        <rdfs:label xml:lang="en">SelfTestDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SeriousIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
        <rdfs:comment xml:lang="en">Serious incident.</rdfs:comment>
        <rdfs:label xml:lang="en">SeriousIncident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SingleUseDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SingleUseDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">A device for a single use.</rdfs:comment>
        <rdfs:label xml:lang="en">SingeUseDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SoftwareRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#SoftwareRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that represents a software risk.</rdfs:comment>
        <rdfs:label xml:lang="en">SoftwareRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#UserNotice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#UserNotice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">A corrective action noticed by user.</rdfs:comment>
        <rdfs:label xml:lang="en">UserNotice</rdfs:label>
    </owl:Class>
    


