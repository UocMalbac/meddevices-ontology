    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#respondsToIncident"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class with field safety corrective actions (FSCA) linked to incidents.</rdfs:comment>
        <rdfs:label xml:lang="en">CorrectiveAction</rdfs:label>
        <skos:prefLabel xml:lang="en">Corrective Action</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CybersecurityRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CybersecurityRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that has CyberSecurityRisk</rdfs:comment>
        <rdfs:label xml:lang="en">CyberSecurityRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isManufacturedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isActive"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isImplantable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isReusable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class that includes a catalog of devices with their risk class, manufacturer and type.</rdfs:comment>
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <rdfs:sameAs rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://publications.europa.eu/resource/authority/class-sum-leg/2403020204</rdfs:sameAs>
        <skos:prefLabel xml:lang="en">Medical Device</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#DiagnosticRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#DiagnosticRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that has a diagnostic risk.</rdfs:comment>
        <rdfs:label xml:lang="en">DiagnosticRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#ImplantableActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">A device that needs energy and that is implantable.</rdfs:comment>
        <rdfs:label xml:lang="en">ImplantableActiveDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#ImplantableDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:comment xml:lang="en">An implantable device.</rdfs:comment>
        <rdfs:label xml:lang="en">ImplantableDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InSituCorrection -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InSituCorrection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Any corrective action with a correction made on place</rdfs:comment>
        <rdfs:label xml:lang="en">InSituCorrection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#isIvd"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A device that can be used to in vitro diagnostic.</rdfs:comment>
        <rdfs:label xml:lang="en">InVitroDiagnosticDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Incident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasDevice"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#hasRisk"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#reportedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class that collects reported incidents associated with specific devices.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
        <skos:prefLabel xml:lang="en">Safety Incident</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InfectionRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InfectionRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that has a risk of infection.</rdfs:comment>
        <rdfs:label xml:lang="en">InfectionRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InjuryRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InjuryRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that carries a risk of injury.</rdfs:comment>
        <rdfs:label xml:lang="en">InjuryRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InterferenceRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#InterferenceRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that poses a risk of interference.</rdfs:comment>
        <rdfs:label xml:lang="en">InterferenceRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MalfunctionRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MalfunctionRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Risk"/>
        <rdfs:comment xml:lang="en">An incident that poses a risk of malfunction.</rdfs:comment>
        <rdfs:label xml:lang="en">MalfunctionRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer -->


    <owl:Class rdf:about="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#Manufacturer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marmi/ontologies/2026/3/meddevices#MedicalDevice"/>
